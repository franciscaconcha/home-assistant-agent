# Add these to data/.env AFTER running `make setup` and `make pair`.
# Use the bot number's WhatsApp account to scan the QR code.
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
# Replace with YOUR sender number, country code included, no +, spaces or punctuation.
WHATSAPP_ALLOWED_USERS=REPLACE_WITH_YOUR_PHONE_NUMBER
WHATSAPP_ALLOW_ALL_USERS=false
WHATSAPP_GROUP_POLICY=pairing
